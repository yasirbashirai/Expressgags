{
  "name": "express-bags-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:dev": "tsx watch src/server/index.ts",
    "db:dev": "prisma dev",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:content"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "1.49.0",
    "next": "15.5.27",
    "nodemailer": "10.0.13",
    "pg": "8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "4.1.5"
  }
}