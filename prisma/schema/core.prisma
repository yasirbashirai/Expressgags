// Express Bags platform database schema (Prisma 7, PostgreSQL).
// Round 1: quote requests, admin users, settings, pricing rules, markets/zones,
// and the order/piece model that Phase 2 (dispatch, tracking, POD) builds on.

generator client {
  provider = "prisma-client"
  output   = "../../src/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users & access
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  STAFF
  DISPATCHER
  DRIVER
  ACCOUNTING
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  role         Role       @default(STAFF)
  active       Boolean    @default(true)
  /// Reserved for TOTP two-factor authentication (Phase 1 security hardening)
  totpSecret   String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  /// TOTP 2FA is enforced at login once enabled
  totpEnabled  Boolean    @default(false)
  failedLogins Int        @default(0)
  lockedUntil  DateTime?
  mustChangePassword Boolean @default(false)
  auditLogs    AuditLog[]
  notes        QuoteNote[]
  employee     Employee?
  quotationsCreated Quotation[] @relation("QuotationAuthor")
}

// ---------------------------------------------------------------------------
// Customers & B2B companies
// ---------------------------------------------------------------------------

model Company {
  id         String          @id @default(cuid())
  name       String
  domain     String?         @unique /// used for HubSpot/Apollo de-duplication
  industry   String?         /// hotels, dmc, cruise, sports, entertainment, corporate…
  segment    String?
  market     String?
  /// B2B account settings (form Q24): onboarding, terms, PO support, centralized invoicing
  accountType   String?   /// hotel | resort | dmc | cruise | corporate | sports | entertainment | event | university | commercial
  accountStatus String    @default("PROSPECT") /// PROSPECT | PENDING | ACTIVE | ON_HOLD
  billingEmail  String?
  paymentTermsDays Int    @default(0)
  poRequired    Boolean   @default(false)
  creditLimitCents Int?
  /// Negotiated pricing: optional rule-set overrides applied by the pricing engines
  negotiatedRules Json?
  taxId         String?
  w9UploadId    String?
  qboCustomerId String?
  hubspotCompanyId String?
  notes         String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  customers  Customer[]
  quotes     QuoteRequest[]
  orders     Order[]
  invoices   Invoice[]
  savedLocations SavedAddress[]
}

model Customer {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  phone            String?
  preferredContact String?
  companyId        String?
  company          Company?       @relation(fields: [companyId], references: [id])
  hubspotContactId String?
  /// Portal login (null until the customer creates an account)
  passwordHash     String?
  emailVerifiedAt  DateTime?
  /// INDIVIDUAL | COMPANY_ADMIN | COMPANY_USER | CONCIERGE (hotel partner staff)
  accountRole      String         @default("INDIVIDUAL")
  /// Optional cost center / PO defaults for corporate users
  defaultCostCenter String?
  language         String         @default("en")
  marketingOptIn   Boolean        @default(false)
  lastLoginAt      DateTime?
  qboCustomerId    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  quotes           QuoteRequest[]
  orders           Order[]
  addresses        SavedAddress[]
  quotations       Quotation[]
  invoices         Invoice[]
  claims           Claim[]
  documents        CustomerDocument[]

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Quote requests
// ---------------------------------------------------------------------------

enum QuoteRoute {
  CUSTOM_QUOTE
  STANDARD_QUOTE
  SPECIAL_ROUTE
}

enum QuoteStatus {
  NEW
  REVIEWING
  QUOTED
  WON
  LOST
  ARCHIVED
}

enum SyncStatus {
  DISABLED
  PENDING
  SYNCED
  FAILED
}

model QuoteRequest {
  id                String       @id @default(cuid())
  reference         String       @unique /// EB-Q-YYMMDD-XXXX
  serviceType       String
  route             QuoteRoute
  routeReasons      String[]
  status            QuoteStatus  @default(NEW)
  pickupMarket      String
  deliveryMarket    String
  serviceDate       String
  totalPieces       Int
  leadSource        String
  billingType       String
  /// Full validated request (QuoteRequest from src/lib/quote-schema.ts)
  payload           Json
  /// Internal pricing preview (never shown publicly while pricing is disabled)
  pricingPreview    Json?
  customerId        String
  customer          Customer     @relation(fields: [customerId], references: [id])
  companyId         String?
  company           Company?     @relation(fields: [companyId], references: [id])
  hubspotSyncStatus SyncStatus   @default(DISABLED)
  hubspotDealId     String?
  hubspotError      String?
  ipHash            String?
  userAgent         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  notes             QuoteNote[]
  events            QuoteEvent[]
  order             Order?
  quotations        Quotation[]
  /// AI lead-qualification summary (internal only)
  aiSummary         Json?

  @@index([status])
  @@index([serviceType])
  @@index([pickupMarket])
  @@index([createdAt])
}

model QuoteNote {
  id        String       @id @default(cuid())
  quoteId   String
  quote     QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?        @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime     @default(now())

  @@index([quoteId])
}

/// Timeline entries (created, status changed, email sent, synced…)
model QuoteEvent {
  id        String       @id @default(cuid())
  quoteId   String
  quote     QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type      String
  detail    String?
  actor     String?
  createdAt DateTime     @default(now())

  @@index([quoteId])
}

// ---------------------------------------------------------------------------
// Orders & pieces (chain of custody foundation for Phase 2)
// ---------------------------------------------------------------------------

enum OrderStatus {
  CONFIRMED
  DRIVER_ASSIGNED
  EN_ROUTE
  PICKED_UP
  AT_FACILITY
  TRANSFERRED_TO_CARRIER
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id           String       @id @default(cuid())
  reference    String       @unique /// EB-YYMMDD-XXXX; pieces are <reference>-01, -02…
  status       OrderStatus  @default(CONFIRMED)
  serviceType  String
  /// local | nationwide | storage | custom (fulfillment path chosen by the decision engine)
  fulfillment  String       @default("local")
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id])
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id])
  quoteId      String?      @unique
  quote        QuoteRequest? @relation(fields: [quoteId], references: [id])
  quotationId  String?      @unique
  quotation    Quotation?   @relation(fields: [quotationId], references: [id])
  /// Route & schedule
  pickup       Json         /// { type, address, facility, market, contact, notes, lat?, lng? }
  delivery     Json
  extraStops   Json?
  serviceDate  DateTime
  timeWindow   String?
  windowStart  DateTime?
  windowEnd    DateTime?
  market       String
  priority     String       @default("NORMAL") /// NORMAL | RUSH | VIP
  vehicleClassCode String?
  specialHandling String?
  accessNotes  String?
  customerNotes String?
  internalNotes String?
  poNumber     String?
  costCenter   String?
  /// Booked by a hotel concierge on behalf of a guest
  guestName    String?
  guestRoom    String?
  bookedByCustomerId String?
  /// Assigned driver identity is visible only to staff and the booked customer after assignment
  assignedDriverRef String?
  /// Money (integer cents)
  retailCents  Int?
  costCents    Int?
  depositCents Int?
  pricingBreakdown Json?
  paymentStatus String      @default("UNPAID") /// UNPAID | DEPOSIT_PAID | PAID | INVOICED | REFUNDED | ACCOUNT
  protectionTier String?    /// basic | plus | vip (module hidden until legal approval)
  protectionCents Int?
  cancelledAt  DateTime?
  cancelReason String?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  pieces       OrderPiece[]
  events       OrderEvent[]
  assignments  Assignment[]
  exceptions   OrderException[]
  proofs       ProofOfDelivery[]
  invoiceLines InvoiceLine[]
  payments     Payment[]
  shipments    CarrierShipment[]
  storage      StorageBooking[]
  notifications Notification[]
  survey       SurveyResponse?
  claims       Claim[]

  @@index([status])
  @@index([serviceDate])
  @@index([customerId])
  @@index([companyId])
  @@index([market])
}

model OrderPiece {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pieceId     String      @unique /// e.g. EB-261015-7K3P-01
  category    String
  status      OrderStatus @default(CONFIRMED)
  barcode     String?     @unique /// barcode / QR / RFID-ready identifier
  conditionNotes String?
  description String?
  weightLbs   Float?
  lengthIn    Float?
  widthIn     Float?
  heightIn    Float?
  /// Current custody location: with driver, facility, storage bay, carrier…
  custodyLocation String?
  storageBay  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  events      OrderEvent[]

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Geography & operations reference data
// ---------------------------------------------------------------------------

model Market {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  tier      String   /// top | next | additional
  isHq      Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  zones     Zone[]
  locations RecognizedLocation[]
}

model Zone {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Zone?    @relation("ZoneTree", fields: [parentId], references: [id])
  children  Zone[]   @relation("ZoneTree")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)

  @@index([marketId])
}

model RecognizedLocation {
  id           String  @id @default(cuid())
  code         String  @unique /// MIA, portmiami, …
  name         String
  type         String  /// airport | cruise-port | hotel | private-aviation | venue
  marketId     String
  market       Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  instructions String?
  surchargeCents Int   @default(0)
  active       Boolean @default(true)
}

model VehicleClass {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  /// Capacity thresholds are set by Express Bags (never invented here)
  maxPieces   Int?
  maxWeightLbs Int?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
}

// ---------------------------------------------------------------------------
// Settings, pricing rules, permissions
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model PricingRuleSet {
  id        String   @id @default(cuid())
  engine    String   /// local | carrier | storage
  version   Int
  active    Boolean  @default(false)
  rules     Json
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([engine, version])
}

model NotableProjectPermission {
  projectId         String   @id /// matches notableProjects[].id in src/content/site.ts
  permissionGranted Boolean  @default(false)
  evidenceNote      String?
  grantedAt         DateTime?
  updatedAt         DateTime @updatedAt
  updatedBy         String?
}

// ---------------------------------------------------------------------------
// Other inbound forms
// ---------------------------------------------------------------------------

model CareerApplication {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  role       String
  market     String?
  experience String?
  message    String?
  resumeId   String?
  status     String   @default("NEW")
  createdAt  DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  topic     String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model Upload {
  id           String   @id @default(cuid())
  originalName String
  storedName   String   @unique
  mimeType     String
  sizeBytes    Int
  /// What this file belongs to (order-photo, signature, pod, employee-doc, vehicle-doc, claim-evidence, cms, invoice-pdf, label…)
  kind         String?
  ownerType    String?
  ownerId      String?
  /// Only CMS media (gallery, blog covers, resources) may ever be served publicly
  isPublic     Boolean  @default(false)
  uploadedBy   String?
  sha256       String?
  createdAt    DateTime @default(now())

  @@index([ownerType, ownerId])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  status    String   /// SENT | LOGGED (no SMTP) | FAILED
  error     String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
