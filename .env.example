# ─────────────────────────────────────────────────────────────────────────────
# Express Bags platform — environment variables
# Copy to .env for local development. In production set these in the host
# (Render for the API, Vercel for the website). Every account belongs to Express Bags, Inc.
# ─────────────────────────────────────────────────────────────────────────────

# Database (PostgreSQL). Local: `npm run db:dev` prints a URL (Prisma dev server). Prod: Neon.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/express_bags?sslmode=disable"

# API
PORT=4000
NODE_ENV=development
# Long random string, 32+ characters (signs admin session cookies)
JWT_SECRET=
# Comma-separated website origins allowed to call the API (prod: https://www.express-bags.com)
WEB_ORIGIN=http://localhost:3000
# Private upload folder (quote attachments, résumés). Never served publicly.
UPLOAD_DIR=./uploads
# Salt for hashing visitor IPs stored with quote requests (anti-abuse only)
IP_HASH_SALT=
# Optional rate limits (requests per 15 minutes per IP)
PUBLIC_RATE_LIMIT=30
LOGIN_RATE_LIMIT=10

# First owner account, created by `npm run db:seed` (leave password empty to generate one)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (SMTP). If SMTP_HOST is empty, emails are logged instead of sent.
# Microsoft 365: smtp.office365.com, port 587, a licensed mailbox (or a relay).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Express Bags <no-reply@express-bags.com>"

# HubSpot private-app token (CRM sync also needs Settings → "Sync new requests to HubSpot")
HUBSPOT_TOKEN=

# Website (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=https://www.express-bags.com

# --- Money module (quotations, payments, invoices, QuickBooks) ---
# Public website base URL used in emailed links (quotation, invoice, checkout return)
PUBLIC_WEB_URL="http://localhost:3000"
# Stripe (Express Bags' own account). Leave empty to use the built-in mock checkout (dev only).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# QuickBooks Online (OAuth2 app + company). All four required to enable the real adapter.
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_REALM_ID=""
QBO_REFRESH_TOKEN=""
# sandbox (default) | production
QBO_ENV="sandbox"
# QuickBooks item used for invoice lines (Products & Services → service item id)
QBO_SERVICE_ITEM_ID=""
# Local Prisma dev server only (PGlite serves one connection at a time). Leave unset in production.
DB_POOL_MAX=1

# --- AI website assistant (Claude by default; Express Bags' own Anthropic account) ---
# Without a key the assistant runs in scripted mode (answers from approved website content only).
ANTHROPIC_API_KEY=
# Optional: claude-opus-5-5 (default) | claude-sonnet-5-5 | claude-haiku-5-5 (owner can also pick in /admin/assistant)
ASSISTANT_MODEL=
# Optional: chat messages per IP per 10 minutes (default 40)
ASSISTANT_RATE_LIMIT=

# ---------------------------------------------------------------------------
# Platform URLs
# ---------------------------------------------------------------------------
# Public API base used in emails, unsubscribe links and Twilio signatures (e.g. https://api.express-bags.com)
PUBLIC_API_URL=
# Customer portal base URL (defaults to PUBLIC_WEB_URL + /account)
PORTAL_URL=
# Next.js server-side fetch base for CMS content (defaults to NEXT_PUBLIC_API_URL)
CMS_API_URL=
CMS_FETCH_TIMEOUT_MS=4000
# Website internal URL the API calls for on-demand revalidation, plus the shared secret (set on BOTH apps)
WEB_INTERNAL_URL=
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Providers (all accounts belong to Express Bags, Inc.). Leave empty to use safe mock mode.
# PROVIDERS_MODE=mock forces mocks even when keys are present (staging/demo).
# ---------------------------------------------------------------------------
PROVIDERS_MODE=
# EasyPost multi-carrier (connect Express Bags' own UPS / FedEx / DHL / USPS accounts in EasyPost)
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=
EASYPOST_API_BASE=https://api.easypost.com/v2
# Twilio SMS / WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_STATUS_CALLBACK_URL=
# Meta Conversions API (server-side lead events, only with marketing consent)
META_CAPI_TOKEN=
META_GRAPH_VERSION=v21.0
META_TEST_EVENT_CODE=
# Background notification worker inside the API process (set "off" when running a separate cron worker)
NOTIFICATION_WORKER=

# ---------------------------------------------------------------------------
# Rate limits (requests per 15 min per IP)
# ---------------------------------------------------------------------------
TRACK_RATE_LIMIT=20
DRIVER_RATE_LIMIT=600
CONTENT_RATE_LIMIT=300

# ---------------------------------------------------------------------------
# Demo seed only (never in production)
# ---------------------------------------------------------------------------
DEMO_DRIVER_EMAIL=
DEMO_DRIVER_PASSWORD=
DEMO_PORTAL_PASSWORD=
